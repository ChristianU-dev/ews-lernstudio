{
  "name": "ews-psychologie-lernstudio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Adaptives EWS-Psychologie Lernstudio (PC & iPhone) auf Basis des UX-mAInd Design-Stacks",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --port 4173 --strictPort",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "audit:content": "python ./scripts/audit_completeness.py",
    "generate:exports": "python ./scripts/build_all_deliverables.py",
    "doctor": "node ./scripts/doctor.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@radix-ui/react-popover": "^1.1.2",
    "cmdk": "^1.0.0",
    "vaul": "^1.1.1",
    "sonner": "^1.7.0",
    "lucide-react": "^0.460.0",
    "@xyflow/react": "^12.3.5",
    "@dagrejs/dagre": "^1.1.4",
    "@tanstack/react-table": "^8.20.5",
    "ts-fsrs": "^4.3.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "@supabase/supabase-js": "^2.46.1",
    "fake-indexeddb": "^6.0.0"
  },
  "devDependencies": {
    "vite": "^6.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^2.1.6",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^25.0.1",
    "@playwright/test": "^1.49.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.34.0"
  }
